{
  "name": "remix-the-web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@oxlint/plugins": "^1.57.0",
    "@typescript/native-preview": "catalog:",
    "oxc-parser": "^0.121.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.17.4",
    "prettier": "^3.3.3",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "git clean -fdX -e '!/.env' .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . -A all --quiet",
    "lint:fix": "oxlint . -A all --fix --quiet",
    "test": "pnpm --recursive --workspace-concurrency=4 --stream run test",
    "test:bun": "pnpm --parallel --if-present run test:bun",
    "typecheck": "pnpm -r typecheck"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
